---
import PageLayout from '../layouts/PageLayout.astro';
import films from '../data/films.json';

// Generated by scripts/import-films.mjs
const { sections } = films;
---

<PageLayout title="Films" description="A log of my film photos, shot on an Olympus.">
	<header class="films-header">
		<h1>Films</h1>
		<p>On my 27th birthday, I received an Olympus. This is my log of films.</p>
		<nav class="films-toc" aria-label="Film sections">
			{sections.map((section) => <a href={`#${section.slug}`}>{section.title}</a>)}
		</nav>
	</header>

	{
		sections.map((section) => (
			<section class="films-section" id={section.slug} aria-labelledby={`${section.slug}-heading`}>
				<h2 id={`${section.slug}-heading`}>{section.title}</h2>
				<div class="masonry">
					{section.photos.map((photo, i) => (
						<a href={photo.full} class="masonry__item" data-lightbox>
							<img
								src={photo.thumb}
								alt={`${section.title}, photo ${i + 1}`}
								width={photo.width}
								height={photo.height}
								loading="lazy"
								decoding="async"
							/>
						</a>
					))}
				</div>
			</section>
		))
	}

	<dialog class="lightbox" aria-label="Photo viewer">
		<img class="lightbox__image" alt="" />
		<button class="lightbox__btn lightbox__btn--close" type="button" aria-label="Close">×</button>
		<button class="lightbox__btn lightbox__btn--prev" type="button" aria-label="Previous photo">‹</button>
		<button class="lightbox__btn lightbox__btn--next" type="button" aria-label="Next photo">›</button>
	</dialog>
</PageLayout>

<script>
	function initLightbox() {
		const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
		if (!dialog || dialog.dataset.init === 'true') return;
		dialog.dataset.init = 'true';

		const image = dialog.querySelector<HTMLImageElement>('.lightbox__image')!;
		const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
		let current = 0;

		const show = (index: number) => {
			current = (index + links.length) % links.length;
			const link = links[current];
			image.src = link.href;
			image.alt = link.querySelector('img')?.alt ?? '';
		};

		links.forEach((link, index) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				show(index);
				dialog.showModal();
			});
		});

		dialog.querySelector('.lightbox__btn--close')!.addEventListener('click', () => dialog.close());
		dialog.querySelector('.lightbox__btn--prev')!.addEventListener('click', () => show(current - 1));
		dialog.querySelector('.lightbox__btn--next')!.addEventListener('click', () => show(current + 1));

		// Clicking the dark backdrop (not the photo or buttons) closes the viewer
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});

		dialog.addEventListener('close', () => image.removeAttribute('src'));
	}

	initLightbox();
	document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
	.films-header h1 {
		margin-top: 0;
	}

	.films-toc {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-md);
		margin-top: var(--space-sm);
		font-size: var(--font-size-meta);
	}

	.films-section {
		scroll-margin-top: 5rem;
	}

	.films-section h2 {
		margin-top: var(--space-xl);
		margin-bottom: var(--space-md);
	}

	/* Masonry: photos flow down each column, column count follows the width */
	.masonry {
		columns: 18rem;
		column-gap: var(--space-sm);
	}

	.masonry__item {
		display: block;
		margin-bottom: var(--space-sm);
		break-inside: avoid;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.masonry__item img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 0;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.masonry__item:hover img {
		transform: scale(1.02);
		opacity: 0.9;
	}

	.lightbox {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: rgba(0, 0, 0, 0.92);
	}

	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox::backdrop {
		background: transparent;
	}

	.lightbox__image {
		max-width: 92vw;
		max-height: 90vh;
		width: auto;
		height: auto;
		margin: 0;
		border-radius: 0;
		object-fit: contain;
	}

	.lightbox__btn {
		position: absolute;
		background: none;
		border: none;
		color: #d4d4d4;
		font-size: 2.5rem;
		line-height: 1;
		padding: var(--space-sm);
		cursor: pointer;
	}

	.lightbox__btn:hover {
		color: var(--color-accent);
	}

	.lightbox__btn--close {
		top: var(--space-xs);
		right: var(--space-sm);
	}

	.lightbox__btn--prev {
		left: var(--space-xs);
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox__btn--next {
		right: var(--space-xs);
		top: 50%;
		transform: translateY(-50%);
	}
</style>
