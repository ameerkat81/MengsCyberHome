---
import { getCollection, render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
	const games = await getCollection('games');
	return games.map((game) => ({
		params: { slug: game.data.slug },
		props: { game },
	}));
}

interface Props {
	game: Awaited<ReturnType<typeof getCollection<'games'>>>[number];
}

const { game } = Astro.props;
const {
	title,
	summary,
	dateStart,
	dateEnd,
	tags,
	heroImage,
	externalLinks,
	intro,
	projectMeta,
} = game.data;
const period = dateEnd ? `${dateStart} – ${dateEnd}` : dateStart;
const introParagraphs =
	intro && intro.length > 0 ? intro : summary ? [summary] : [];
const { Content } = await render(game);
---

<PageLayout title={title} description={summary} bodyClass="page-theme--project">
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href="/projects">← Projects</a>
	</nav>

	<header class="project-header project-header--split">
		{
			heroImage && (
				<div class="project-header__hero project-header__hero--shaped">
					<img src={heroImage} alt={title} loading="eager" />
				</div>
			)
		}
		<div class="project-header__split">
			<div class="project-header__intro">
				{introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<div class="project-header__meta">
				{
					projectMeta?.time ? (
						<p>
							<strong>Time:</strong> {projectMeta.time}
						</p>
					) : (
						<p>
							<strong>Time:</strong> {period}
						</p>
					)
				}
				{
					projectMeta?.role && (
						<p>
							<strong>Role:</strong> {projectMeta.role}
						</p>
					)
				}
				{
					projectMeta?.tools && (
						<p>
							<strong>Tools:</strong> {projectMeta.tools}
						</p>
					)
				}
				{
					tags.length > 0 && (
						<ul class="project-header__tags">
							{tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)
				}
				{
					externalLinks && externalLinks.length > 0 && (
						<ul class="project-header__links">
							{externalLinks.map((link) => (
								<li>
									<a
										href={link.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{link.label} →
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</header>

	<Prose largeHeadings>
		<Content />
	</Prose>
</PageLayout>

<style>
	.breadcrumb {
		margin-bottom: var(--space-md);
		font-size: 0.9rem;
	}

	.project-header {
		margin-bottom: var(--space-lg);
	}

	.project-header--split {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		margin-bottom: var(--space-xl);
	}

	.project-header__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		list-style: none;
		margin: 0 0 var(--space-sm);
		padding: 0;
	}

	.project-header__tags li {
		font-size: 0.75rem;
		padding: 0.15rem 0.5rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text-muted);
	}

	.project-header__links {
		list-style: none;
		margin: var(--space-md) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.project-header__links a {
		font-weight: 500;
	}

	.project-header__hero--shaped {
		width: 100%;
		margin: 0 0 var(--space-md);
		overflow: hidden;
		border-radius: var(--radius);
	}

	.project-header__hero--shaped img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 66vh;
	}

	.project-header__split {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-lg);
		align-items: start;
	}

	.project-header__intro p {
		margin: 0 0 var(--space-sm);
		line-height: 1.65;
	}

	.project-header__intro p:last-child {
		margin-bottom: 0;
	}

	.project-header__meta p {
		margin: 0 0 var(--space-xs);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.project-header__meta .project-header__tags {
		margin-top: var(--space-sm);
	}

	@media (max-width: 768px) {
		.project-header__hero--shaped img {
			max-height: 50vh;
		}

		.project-header__split {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}
</style>
