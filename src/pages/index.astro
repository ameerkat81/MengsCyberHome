---
import HomeEntryCard from '../components/HomeEntryCard.astro';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="XueMeng Geng"
	description="Game designer living in Beijing and Los Angeles. Personal projects, professional experience, and blog."
>
	<section class="intro">
		<div class="intro__lead">
			<div class="intro__aside">
				<img
					src="/images/avatar.jpg"
					alt="méng turning to smile at night beside a coffee shop sign"
					class="intro__avatar"
					width="192"
					height="288"
					loading="eager"
				/>
			</div>
			<div class="intro__text">
				<h1>Hi! Welcome to my cyber cabin!</h1>
				<p>
					I’m méng (萌), a game designer living in Beijing and Los Angeles.
				</p>
				<p>
					I began my adult life as an iOS developer at a big tech company, in a world of
					structure and efficiency. As I learned more about myself and the world, I found my
					way back to games, a chance spark from my undergraduate years. Now, I’m pursuing an
					MFA in Interactive Media at USC.
				</p>
				<p>
					I once thought I was meant to be an engineer, or that I should be. But one small
					question mark was enough to unsettle that certainty.
				</p>
				<p>
					Life is strange, isn’t it? Now, I just feel lucky to experience it, and to create
					something out of it.
				</p>
			</div>
		</div>
	</section>

	<section class="entries" aria-labelledby="entries-heading">
		<h2 id="entries-heading">Explore</h2>
		<div class="entries__grid">
			<HomeEntryCard
				href="/projects"
				title="Game Projects"
				description="Personal and team games, prototypes, and professional experience."
				image="/images/explore/usc-games-room.jpg"
				imageLayout="cover"
				wide
			/>
			<HomeEntryCard
				href="/blog"
				title="Blog"
				description="Thoughts and journal entries."
				image="/images/explore/abc-machapuchare.jpg"
			/>
			<HomeEntryCard
				href="https://thedebbies.bandcamp.com/"
				title="Music"
				description="My band back in Beijing. I can never forget those days with these two girls."
				image="/images/explore/debbies-poster.jpg"
				external
			/>
		</div>
	</section>
</PageLayout>

<style>
	.intro__lead {
		display: flex;
		gap: var(--space-md);
		align-items: flex-start;
	}

	.intro__aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-sm);
		flex-shrink: 0;
		width: 12rem;
	}

	.intro__avatar {
		width: 12rem;
		height: auto;
		border-radius: var(--radius);
		margin: 0;
	}

	.intro__text h1 {
		margin-top: 0;
		margin-bottom: var(--space-md);
	}

	.intro__text p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 520px) {
		.intro__lead {
			flex-direction: column;
			align-items: center;
		}

		.intro__text h1 {
			text-align: center;
		}
	}

	.entries h2 {
		margin-top: var(--space-xl);
		margin-bottom: var(--space-md);
		font-size: 1.25rem;
	}

	/* Column count follows the available width; dense flow backfills gaps left by wide cards */
	.entries__grid {
		container-type: inline-size;
		display: grid;
		gap: var(--space-md);
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		grid-auto-flow: dense;
	}
</style>
