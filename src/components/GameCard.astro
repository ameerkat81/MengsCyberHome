---
import type { CollectionEntry } from 'astro:content';

interface Props {
	game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, slug, summary, dateStart, dateEnd, tags, heroImage } = game.data;
const period = dateEnd ? `${dateStart} – ${dateEnd}` : dateStart;
---

<article class="game-card">
	<a href={`/projects/${slug}`} class="game-card__link">
		{
			heroImage && (
				<div class="game-card__image-wrap">
					<img src={heroImage} alt="" class="game-card__image" loading="lazy" />
				</div>
			)
		}
		<div class="game-card__body">
			<h3 class="game-card__title">{title}</h3>
			<p class="game-card__summary">{summary}</p>
			{
				tags.length > 0 && (
					<ul class="game-card__tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
			<p class="game-card__meta">{period}</p>
			<span class="game-card__cta">Learn more →</span>
		</div>
	</a>
</article>

<style>
	.game-card {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		overflow: hidden;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.game-card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
	}

	.game-card__link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.game-card__link:hover {
		text-decoration: none;
		color: inherit;
	}

	.game-card__image-wrap {
		aspect-ratio: 16 / 9;
		background: var(--color-border);
		overflow: hidden;
	}

	.game-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.game-card__body {
		padding: var(--space-md);
	}

	.game-card__title {
		margin: 0 0 var(--space-xs);
		font-size: 1.125rem;
	}

	.game-card:hover .game-card__title {
		color: var(--color-accent);
	}

	.game-card__summary {
		margin: 0 0 var(--space-sm);
		font-size: var(--font-size-meta);
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	.game-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		list-style: none;
		margin: 0 0 var(--space-sm);
		padding: 0;
	}

	.game-card__tags li {
		font-size: var(--font-size-sm);
		padding: 0.15rem 0.5rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text-muted);
	}

	.game-card__meta {
		margin: 0 0 var(--space-xs);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
	}

	.game-card__cta {
		font-size: var(--font-size-meta);
		color: var(--color-accent);
	}
</style>
