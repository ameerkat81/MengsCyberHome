---
interface Props {
	href: string;
	title: string;
	description: string;
	external?: boolean;
	image?: string;
	imageLayout?: 'background' | 'cover';
	wide?: boolean;
}

const {
	href,
	title,
	description,
	external = false,
	image,
	imageLayout = 'background',
	wide = false,
} = Astro.props;
---

<a
	href={href}
	class:list={[
		'entry-card',
		image && `entry-card--${imageLayout}`,
		{ 'entry-card--wide': wide },
	]}
	{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	{image && <img src={image} alt="" class="entry-card__image" loading="lazy" />}
	<span class="entry-card__content">
		<span class="entry-card__title">{title}</span>
		<span class="entry-card__desc">{description}</span>
		<span class="entry-card__arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
	</span>
</a>

<style>
	.entry-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.entry-card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
		text-decoration: none;
		color: inherit;
	}

	.entry-card__content {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: var(--space-md);
	}

	.entry-card__title {
		display: block;
		font-weight: 600;
		font-size: 1.125rem;
		margin-bottom: var(--space-xs);
		color: var(--color-heading);
	}

	.entry-card:hover .entry-card__title {
		color: var(--color-accent);
	}

	.entry-card__desc {
		display: block;
		font-size: var(--font-size-meta);
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	.entry-card__arrow {
		margin-top: auto;
		padding-top: var(--space-sm);
		color: var(--color-accent);
		font-size: 1.25rem;
	}

	/* Spans two columns of the parent grid; falls back to one when only one column fits */
	.entry-card--wide {
		grid-column: span 2;
	}

	@container (width < 33.5rem) {
		.entry-card--wide {
			grid-column: auto;
		}
	}

	.entry-card__image {
		display: block;
		width: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	/* Cover: image across the top, text below */
	.entry-card--cover .entry-card__image {
		aspect-ratio: 2 / 1;
		object-position: center 30%;
	}

	/* Background: image fills the card; text sits on a dark band at the bottom */
	.entry-card--background {
		min-height: 26rem;
	}

	.entry-card--background .entry-card__image {
		position: absolute;
		inset: 0;
		height: 100%;
		object-position: center 15%;
	}

	.entry-card--background:hover .entry-card__image {
		transform: scale(1.03);
	}

	.entry-card--background .entry-card__content {
		position: relative;
		flex: 0;
		margin-top: auto;
		background: rgba(20, 20, 20, 0.78);
	}

	.entry-card--background .entry-card__desc {
		color: var(--color-text);
	}
</style>
