---
interface Props {
	href: string;
	title: string;
	description: string;
	external?: boolean;
	image?: string;
}

const { href, title, description, external = false, image } = Astro.props;
---

<a
	href={href}
	class:list={['entry-card', image && 'entry-card--image']}
	{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	{image && <img src={image} alt="" class="entry-card__image" loading="lazy" />}
	<span class="entry-card__content">
		<span class="entry-card__title">{title}</span>
		<span class="entry-card__desc">{description}</span>
		<span class="entry-card__arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
	</span>
</a>

<style>
	.entry-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.entry-card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
		text-decoration: none;
		color: inherit;
	}

	.entry-card__content {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: var(--space-md);
	}

	.entry-card__title {
		display: block;
		font-weight: 600;
		font-size: 1.125rem;
		margin-bottom: var(--space-xs);
		color: var(--color-heading);
	}

	.entry-card:hover .entry-card__title {
		color: var(--color-accent);
	}

	.entry-card__desc {
		display: block;
		font-size: var(--font-size-meta);
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	.entry-card__arrow {
		margin-top: auto;
		padding-top: var(--space-sm);
		color: var(--color-accent);
		font-size: 1.25rem;
	}

	/* Image fills the card; text sits on a dark band at the bottom */
	.entry-card--image {
		min-height: 26rem;
	}

	.entry-card__image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
		object-position: center 15%;
		transition: transform 0.3s ease;
	}

	.entry-card--image:hover .entry-card__image {
		transform: scale(1.03);
	}

	.entry-card--image .entry-card__content {
		position: relative;
		flex: 0;
		margin-top: auto;
		background: rgba(20, 20, 20, 0.78);
	}

	.entry-card--image .entry-card__desc {
		color: var(--color-text);
	}
</style>
