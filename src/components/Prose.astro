---
interface Props {
	largeHeadings?: boolean;
	blog?: boolean;
}

const { largeHeadings = false, blog = false } = Astro.props;
---

<div class:list={['prose', { 'prose--large-headings': largeHeadings, 'prose--blog': blog }]}>
	<slot />
</div>

<style>
	.prose :global(h2:first-child),
	.prose :global(h3:first-child) {
		margin-top: 0;
	}

	.prose :global(h2) {
		font-size: 1.125rem;
		margin-top: var(--space-md);
		margin-bottom: var(--space-sm);
	}

	.prose :global(h3) {
		font-size: 1rem;
		margin-top: var(--space-sm);
		margin-bottom: var(--space-xs);
	}

	.prose--large-headings :global(h2) {
		font-size: 2rem;
	}

	.prose--large-headings :global(h3) {
		font-size: 1.5rem;
	}

	.prose :global(p:last-child),
	.prose :global(ul:last-child),
	.prose :global(ol:last-child) {
		margin-bottom: 0;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: var(--space-sm);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		font-size: 0.85rem;
	}

	.prose--blog :global(h2) {
		font-size: 1.125rem;
		margin-top: var(--space-lg);
		margin-bottom: var(--space-sm);
	}

	.prose--blog :global(h3) {
		font-size: 1rem;
		margin-top: var(--space-md);
		margin-bottom: var(--space-xs);
	}

	.prose--blog :global(p:has(> img)) {
		text-align: center;
		margin: var(--space-md) 0 var(--space-xs);
	}

	.prose--blog :global(p:has(> img) img) {
		display: inline-block;
		max-width: 100%;
		margin: 0 auto;
	}

	.prose--blog :global(p:has(> img) + p) {
		text-align: center;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin-top: 0;
		margin-bottom: var(--space-md);
	}

	.prose--blog :global(.blog-figure) {
		margin: var(--space-md) 0 var(--space-md);
		text-align: center;
	}

	.prose--blog :global(.blog-figure img) {
		display: inline-block;
		max-width: 100%;
		margin: 0 auto;
	}

	.prose--blog :global(.blog-figure figcaption) {
		margin-top: var(--space-xs);
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}
</style>
