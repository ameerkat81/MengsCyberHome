---
import '../styles/global.css';
import Nav from './Nav.astro';

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}

const {
	title = 'XueMeng Geng - Game Developer',
	description = 'Game developer and iOS engineer based in Beijing.',
	bodyClass,
} = Astro.props;

const pageTitle =
	title === 'XueMeng Geng - Game Developer'
		? title
		: `${title} | XueMeng Geng - Game Developer`;

const fontsHref =
	'https://fonts.googleapis.com/css2?family=Sansita:ital,wght@0,700;1,700&family=Nunito+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={fontsHref} rel="stylesheet" />
	</head>
	<body class:list={[bodyClass]}>
		<Nav />
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<p>
					Contact: <a href="mailto:ameerkat81@gmail.com">ameerkat81@gmail.com</a>
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	main {
		min-height: calc(100vh - 120px);
		padding: var(--space-lg) 0 var(--space-xl);
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: var(--space-md) 0;
		background: var(--color-surface);
	}

	.site-footer p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		text-align: center;
	}
</style>
